# Copy to .env and fill in. Never commit .env.
LLM_MODE=mock                  # mock (deterministic, default) | bedrock | featherless | ollama | openai_compatible
# Short-term Bedrock API key (bearer token) from the AWS console (Bedrock > API keys). Never commit it.
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=us-west-2           # eu-central-1 once an EU key exists (then use eu. model IDs)
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
# AA_DB=agent-assurance.sqlite3   # default: in-memory (fresh state on every start)
# LLM call accounting (backend/llm/adapter.py): list-price estimates, per-task max_tokens caps, one retry, spend cap.
# LLM_SPEND_CAP_USD=20         # above this estimate the adapter switches to mock mode and logs it
# LLM_TIMEOUT_S=30
# LLM_EFFORT=off               # off | on (low; medium for plans) | low | medium — untested on Bedrock, smoke-test first
# Other providers (same adapter, same accounting; synthetic data only):
# FEATHERLESS_API_KEY=         # open-weight models, OpenAI-compatible; FEATHERLESS_MODEL=openai/gpt-oss-120b
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1   # a local model, nothing leaves the machine; OLLAMA_MODEL=qwen3:8b
# LLM_BASE_URL= LLM_API_KEY= LLM_MODEL=       # any other OpenAI-compatible server (LLM_MODE=openai_compatible)
